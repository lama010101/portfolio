---
import StudioLayout from '../layouts/StudioLayout.astro';
import { SITE_NAME, mailto } from '../config';
import { engagementModel, languagePairs, onboardingSteps, partnerFacts, partnerServiceTypes, tools } from '../data/studio';

const description = `Vendor onboarding for agencies and vendors: ${SITE_NAME} provides EN>FR, FR>EN and EN<>ES localization QA, linguistic QA, functional QA and multilingual AI evaluation subcontracting.`;
const vendorMailto = mailto(`Vendor onboarding — ${SITE_NAME}`);
---
<StudioLayout title="For agencies" description={description} path="/partners/">
  <section class="ll-page-hero">
    <div class="ll-wrap">
      <p class="ll-crumbs"><a href="/">Home</a> / For agencies</p>
      <p class="ll-eyebrow">Vendor onboarding</p>
      <h1 class="ll-h1">Add a multilingual QA vendor <em>without adding headcount.</em></h1>
      <p class="ll-sub" style="margin-top:1rem">You keep the client relationship and project management. {SITE_NAME} delivers the language-layer work inside your tracker and tools, under NDA when needed. Human specialists and subcontractors join per project when the work needs them.</p>
      <div class="ll-actions">
        <a class="ll-btn ll-btn-signal" href={vendorMailto}>For agencies: add us to your vendor database <span aria-hidden="true">&rarr;</span></a>
        <a class="ll-btn ll-btn-ghost" href="/capability-statement.pdf">Download capability statement (PDF)</a>
        <button type="button" class="ll-btn ll-btn-ghost" data-print>Print / save this page</button>
      </div>
    </div>
  </section>

  <section class="ll-sec" aria-labelledby="p-pairs">
    <div class="ll-wrap">
      <p class="ll-eyebrow">Language pairs offered</p>
      <h2 id="p-pairs" class="ll-h2">French leads. <em>English and Spanish support.</em></h2>
      <div class="ll-pair-grid">
        {languagePairs.map((l) => (
          <article class="ll-card ll-pair">
            <span>{l.pair}</span>
            <p>{l.note}</p>
          </article>
        ))}
      </div>
      <p class="ll-note">French is the native lead language. English is near-native. Spanish is professional and offered as secondary support, especially for review and second-language checks.</p>
    </div>
  </section>

  <section class="ll-sec ll-sec-alt" aria-labelledby="p-services">
    <div class="ll-wrap">
      <p class="ll-eyebrow">Service types</p>
      <h2 id="p-services" class="ll-h2">What agencies can subcontract.</h2>
      <div class="ll-service-list">
        {partnerServiceTypes.map((service, i) => (
          <article class="ll-card ll-service-row">
            <span class="ll-num">0{i + 1}</span>
            <h3>{service}</h3>
            <p>
              {service === 'Localization/i18n QA' && 'Functional internationalization and localization testing across apps, web products and games: locale formats, truncation, encoding, untranslated UI and layout regressions.'}
              {service === 'Functional QA' && 'Scoped functional passes, regression checks and retests with reproducible steps, severity and evidence logged in your tracker.'}
              {service === 'Linguistic QA' && 'Native-French linguistic review with English near-native support and Spanish professional secondary checks: grammar, tone, terminology, consistency and cultural fit.'}
              {service === 'Multilingual AI output evaluation' && 'Human evaluation of model outputs in French, English and Spanish, including accuracy, fluency, instruction following, cultural fit and cross-language consistency.'}
              {service === 'Rubric and annotation-guideline writing' && 'Task-specific rubrics, annotation guidelines, pass/fail examples and calibration material that help reviewers score consistently.'}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ll-sec" aria-labelledby="p-model">
    <div class="ll-wrap">
      <p class="ll-eyebrow">Engagement model</p>
      <h2 id="p-model" class="ll-h2">Built for vendor databases.</h2>
      <div class="ll-grid-2" style="margin-top:2rem">
        <div class="ll-card">
          <h3 style="font-family:var(--serif);font-size:1.3rem;margin-bottom:0.75rem">Commercial model</h3>
          <ul class="ll-proof-body" style="padding:0">
            {engagementModel.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="ll-card">
          <h3 style="font-family:var(--serif);font-size:1.3rem;margin-bottom:0.75rem">Tracker &amp; tool fit</h3>
          <p style="font-size:0.92rem;color:var(--ink-2);margin-bottom:0.75rem">Work is delivered in the tools your team already uses. Current working stack includes:</p>
          <ul class="ll-cats" style="margin-top:0">
            {tools.map((t) => <li class="ll-tag" style="border-color:var(--rule);color:var(--ink-2)">{t}</li>)}
          </ul>
        </div>
      </div>

      <div class="ll-table-wrap" style="margin-top:2.5rem">
        <table class="ll-table">
          <tbody>
            {partnerFacts.map((f) => (
              <tr><th scope="row">{f.k}</th><td>{f.v}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ll-sec ll-sec-alt" aria-labelledby="p-onboarding">
    <div class="ll-wrap">
      <p class="ll-eyebrow">How to onboard us</p>
      <h2 id="p-onboarding" class="ll-h2">Four steps from vendor form <em>to production batch.</em></h2>
      <ol class="ll-steps ll-steps-four">
        {onboardingSteps.map((s) => (
          <li class="ll-step"><b>{s.n}</b><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="ll-band" style="margin-top:2.5rem">
        <div>
          <h3>Start with the vendor onboarding email.</h3>
          <p>The message opens pre-filled with the subject “Vendor onboarding — {SITE_NAME}”. Include your language pairs, service types, volumes, tracker and timeline.</p>
        </div>
        <div class="ll-actions">
          <a class="ll-btn ll-btn-signal" href={vendorMailto}>Open the pre-filled email</a>
          <a class="ll-btn ll-btn-ghost" href="/capability-statement.pdf">Capability statement (PDF)</a>
        </div>
      </div>
    </div>
  </section>
</StudioLayout>
