---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { CONTACT_EMAIL } from '../config';
import { ctas } from '../content/site';
import { contactCopy } from '../content/pages';
import { contactUi } from '../content/ui';

const hrefs = [ctas.spotCheck.href, ctas.quote.href, ctas.build.href];
---
<StudioLayout title={contactCopy.meta.title} description={contactCopy.meta.description} path="/contact/">
  <PageHero eyebrow={contactCopy.hero.eyebrow} titleA={contactCopy.hero.titleA} titleB={contactCopy.hero.titleB} lede={contactCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>
    <div class="ds-panel">
      <p class="ds-eyebrow">{contactCopy.direct.eyebrow}</p>
      <h3>{contactCopy.direct.title}</h3>
      <p><a class="ds-textlink" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="contact-routes">
    <div class="ds-wrap">
      <SectionHeading eyebrow={contactCopy.routes.eyebrow} title={contactCopy.routes.title} id="contact-routes" />
      <div class="ds-grid-3">
        {contactCopy.routes.items.map((item, index) => (
          <article class="ds-method-card ds-reveal">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="ds-textlink" href={hrefs[index]}>{item.label}<span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={contactUi.cta.title}
    text={contactUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
