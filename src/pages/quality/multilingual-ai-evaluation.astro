---
import StudioLayout from '../../layouts/StudioLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ctas } from '../../content/site';
import { aiEvaluationCopy } from '../../content/quality';
import { aiEvaluationUi, sharedUi } from '../../content/ui';
---
<StudioLayout title={aiEvaluationCopy.meta.title} description={aiEvaluationCopy.meta.description} path="/quality/multilingual-ai-evaluation/">
  <PageHero eyebrow={aiEvaluationCopy.hero.eyebrow} titleA={aiEvaluationCopy.hero.titleA} titleB={aiEvaluationCopy.hero.titleB} lede={aiEvaluationCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/services/#ai-evaluation-pilot">{sharedUi.aiEvaluationPilotLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{aiEvaluationUi.aside.title}</h3>
      <p class="ds-section-lede">{aiEvaluationUi.aside.text}</p>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="ai-evaluation-method">
    <div class="ds-wrap">
      <SectionHeading eyebrow={aiEvaluationUi.methodHeading.eyebrow} title={aiEvaluationUi.methodHeading.title} id="ai-evaluation-method" />
      <div class="ds-grid-3">
        {aiEvaluationCopy.sections.map((section) => (
          <article class="ds-method-card ds-reveal">
            <h3>{section.title}</h3>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={aiEvaluationUi.cta.title}
    text={aiEvaluationUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
