---
import StudioLayout from '../../layouts/StudioLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ctas } from '../../content/site';
import { frenchLqaCopy } from '../../content/quality';
import { frenchLqaUi, sharedUi } from '../../content/ui';
---
<StudioLayout title={frenchLqaCopy.meta.title} description={frenchLqaCopy.meta.description} path="/quality/french-lqa-testing/">
  <PageHero eyebrow={frenchLqaCopy.hero.eyebrow} titleA={frenchLqaCopy.hero.titleA} titleB={frenchLqaCopy.hero.titleB} lede={frenchLqaCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/services/#lqa-day">{sharedUi.lqaDayPackageLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{frenchLqaUi.aside.title}</h3>
      <p class="ds-section-lede">{frenchLqaUi.aside.text}</p>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="french-lqa-method">
    <div class="ds-wrap">
      <SectionHeading eyebrow={frenchLqaUi.methodHeading.eyebrow} title={frenchLqaUi.methodHeading.title} id="french-lqa-method" />
      <div class="ds-grid-3">
        {frenchLqaCopy.sections.map((section) => (
          <article class="ds-method-card ds-reveal">
            <h3>{section.title}</h3>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={frenchLqaUi.cta.title}
    text={frenchLqaUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
