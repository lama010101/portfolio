---
import StudioLayout from '../layouts/StudioLayout.astro';
import { notFoundCopy } from '../content/pages';
---
<StudioLayout title={notFoundCopy.meta.title} description={notFoundCopy.meta.description} path="/404/">
  <section class="ds-pagehero">
    <div class="ds-wrap">
      <p class="ds-eyebrow">{notFoundCopy.eyebrow}</p>
      <h1 class="ds-h1">{notFoundCopy.title}</h1>
      <p class="ds-lede">{notFoundCopy.text}</p>
      <div class="ds-actions">
        <a class="ds-btn ds-btn-primary" href="/">{notFoundCopy.homeLabel}</a>
        <a class="ds-btn ds-btn-ghost" href="/services/">{notFoundCopy.servicesLabel}</a>
      </div>
    </div>
  </section>
</StudioLayout>
