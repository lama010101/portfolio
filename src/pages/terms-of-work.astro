---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { ctas } from '../content/site';
import { termsCopy } from '../content/pages';
import { sharedUi, termsUi } from '../content/ui';
---
<StudioLayout title={termsCopy.meta.title} description={termsCopy.meta.description} path="/terms-of-work/">
  <PageHero eyebrow={termsCopy.hero.eyebrow} titleA={termsCopy.hero.titleA} titleB={termsCopy.hero.titleB} lede={termsCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/services/">{sharedUi.compareServicesLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{termsUi.aside.title}</h3>
      <p class="ds-section-lede">{termsUi.aside.text}</p>
    </div>
  </PageHero>

  <section class="ds-section" aria-label={sharedUi.termsDetailsLabel}>
    <div class="ds-wrap ds-grid-2">
      {termsCopy.sections.map((section) => (
        <article class="ds-method-card ds-reveal">
          <h3>{section.title}</h3>
          <p>{section.text}</p>
        </article>
      ))}
    </div>
  </section>

  <CtaBand
    title={termsUi.cta.title}
    text={termsUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.contact.label}
    secondaryHref={ctas.contact.href}
  />
</StudioLayout>
