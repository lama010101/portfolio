---
import Layout from '../../layouts/AtelierLayout.astro';
import Link from '../../components/atelier/Link.astro';
import Ph from '../../components/atelier/Ph.astro';
import { atelier, hireTasks, mailto } from '../../data/atelier';

const timelines = ['As soon as possible', 'Within 2–4 weeks', 'Within 1–3 months', 'Flexible / exploring'];
---
<Layout path="/atelier/hire/" title="How can I help you?"
  description="Hire Laurent Martenot: multilingual AI output evaluation (EN/FR/ES), localization and i18n quality testing for AI products, evaluation guidelines, and directing AI-built products.">

  <section class="at-page-head" id="top" data-rail="Intro">
    <div class="at-wrap">
      <p class="at-eyebrow">How can I help you?</p>
      <h1>Let's turn your next idea into something <em class="at-serif">real.</em></h1>
      <p class="at-lead">Choose the closest match and start a conversation. Not sure? Tell me the problem.</p>
    </div>
  </section>

  <section class="at-sec" id="tasks" data-rail="Task cards">
    <div class="at-wrap">
      <p class="at-eyebrow">Where I can help most</p>
      <div class="at-grid at-g2">
        {hireTasks.map((t, i) => (
          <article class="at-card at-task" data-reveal>
            <span class="at-num">0{i + 1}</span>
            <h3>{t.title}</h3>
            <p class="at-muted">{t.text}</p>
            <Link href={mailto(t.subject, `Hello Laurent,\n\nI would like to discuss: ${t.title}.\n\n`)} variant="line" small>Discuss this</Link>
          </article>
        ))}
      </div>

      <div class="at-brief" style="margin-top:2.4rem" data-reveal>
        <span class="at-mono" style="color:var(--at-verm)">Brief builder</span>
        <h3 style="margin-top:0.5rem">Compose a project brief in three choices.</h3>
        <p class="at-muted">Pick a task, a timeline and the languages involved — this builds a ready-to-send email and a copyable brief.</p>
        <form id="at-brief" onsubmit="return false">
          <div class="at-brief-grid">
            <div class="at-field">
              <label for="at-brief-task">Task</label>
              <select id="at-brief-task">
                {hireTasks.map((t) => <option value={t.title}>{t.title}</option>)}
              </select>
            </div>
            <div class="at-field">
              <label for="at-brief-time">Timeline</label>
              <select id="at-brief-time">
                {timelines.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <fieldset class="at-field">
              <legend>Languages</legend>
              <label class="at-check"><input type="checkbox" name="lang" value="English" checked /> English</label>
              <label class="at-check"><input type="checkbox" name="lang" value="French" /> French</label>
              <label class="at-check"><input type="checkbox" name="lang" value="Spanish" /> Spanish</label>
            </fieldset>
          </div>
          <output class="at-brief-out" id="at-brief-out" aria-live="polite"></output>
          <div class="at-actions" style="margin-top:0">
            <a class="at-btn at-btn-ink" id="at-brief-mailto" href={mailto('Project brief')}>Send this brief by email</a>
            <button class="at-btn at-btn-line" type="button" id="at-brief-copy">Copy brief</button>
          </div>
        </form>
      </div>

      <p style="margin-top:2.2rem"><strong>Not sure? Tell me the problem.</strong></p>
      <div class="at-actions" style="margin-top:0.6rem">
        <Link href={mailto('Tell me what you need')} variant="ink">Tell me what you need</Link>
      </div>
    </div>
  </section>

  <section class="at-sec at-sec-tint" id="scope" data-rail="Broader scope">
    <div class="at-wrap">
      <p class="at-eyebrow">Broader scope</p>
      <h2>Three service areas.</h2>
      <div class="at-grid at-g3" style="margin-top:2.4rem">
        <article class="at-card">
          <h3>AI Product &amp; Business Development</h3>
          <ul class="at-muted">
            <li>Product conception.</li>
            <li>Business opportunity analysis.</li>
            <li>Product requirements.</li>
            <li>AI-assisted development coordination.</li>
            <li>Product validation.</li>
          </ul>
        </article>
        <article class="at-card">
          <h3>AI Solutions &amp; Workflow Development</h3>
          <ul class="at-muted">
            <li>Identify processes suitable for AI.</li>
            <li>Design AI-assisted workflows.</li>
            <li>Coordinate implementation.</li>
            <li>Evaluate outputs and reliability.</li>
            <li>Improve operational efficiency.</li>
          </ul>
        </article>
        <article class="at-card">
          <h3>AI Evaluation &amp; Multilingual QA</h3>
          <ul class="at-muted">
            <li>Multilingual interface evaluation.</li>
            <li>Localization QA.</li>
            <li>AI output evaluation.</li>
            <li>Cultural and linguistic consistency.</li>
            <li>Business-oriented quality assessment.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="at-sec" id="background" data-rail="Background">
    <div class="at-wrap at-grid at-g2">
      <div>
        <p class="at-eyebrow">Background</p>
        <h2>Experience behind the offer.</h2>
        <p>I performed software and product testing in internationalization and localization teams at <strong>Google (via Accenture)</strong> and <strong>Apple (via Moravia)</strong>, and I bring thirty years of international business experience — B2B sales, startup project management and product ownership.</p>
        <ul>
          <li>QA Test Engineer, i18n — Google (via Accenture), Mountain View, 2021–2022.</li>
          <li>QA Test Engineer, l10n — Apple (via Moravia), Cupertino, 2016–2017.</li>
          <li>Functional Consultant — Lovie Studio, San José, 2018–2022.</li>
          <li>Independent Product Owner — Backtothepast, Thailand, 2022–present.</li>
        </ul>
      </div>
      <div>
        <p class="at-eyebrow">References</p>
        <h2>Projects I can point to.</h2>
        <ul>
          <li><a class="at-tlink" href="/atelier/backtothepast/">BackToThePast (Guess-History)</a> — live in alpha.</li>
          <li>LIKED — personal interests organizer.</li>
          <li>PromptPulse — collective intelligence concept.</li>
        </ul>
        <p class="at-muted" style="margin-top:1.4rem">A business and sales professional with thirty years of international experience who now conceives, directs and evaluates AI-built products. French-American, based in Thailand, working remotely across time zones.</p>
      </div>
    </div>
  </section>

  <section class="at-sec at-sec-tint" id="contact" data-rail="Contact">
    <div class="at-wrap">
      <p class="at-eyebrow">Contact</p>
      <h2>Tell me what you need.</h2>
      <div class="at-actions">
        <Link href={mailto('Project inquiry')} variant="verm">Discuss a project</Link>
        <Link value={atelier.linkedin} label="LinkedIn profile URL" variant="line">LinkedIn</Link>
        <a class="at-tlink" href={`mailto:${atelier.email}`}>{atelier.email}</a>
      </div>
    </div>
  </section>
</Layout>
