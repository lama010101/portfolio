---
import Layout from '../../layouts/AtelierLayout.astro';
import Link from '../../components/atelier/Link.astro';
import Shot from '../../components/atelier/Shot.astro';
import Ph from '../../components/atelier/Ph.astro';
import Blueprint from '../../components/atelier/Blueprint.astro';
import BlueprintArt from '../../components/atelier/BlueprintArt.astro';
import { atelier, mailto } from '../../data/atelier';
---
<Layout path="/atelier/"
  title="Laurent Martenot — I turn business ideas into working products using AI"
  description="Laurent / Atelier: a business and product builder's field notebook. Multilingual AI evaluation (EN/FR/ES), i18n quality testing and AI-directed product building.">

  <section class="at-hero" id="top" data-rail="Intro">
    <div class="at-wrap at-hero-grid">
      <div data-reveal>
        <p class="at-eyebrow">{atelier.tagline}</p>
        <h1>I turn business ideas into <em class="at-serif">working products</em> using AI.</h1>
        <p class="at-hero-sub">Business professional. Product thinker. AI-native builder.</p>
        <p class="at-lead">I combine commercial experience with hands-on AI to conceive, develop and launch digital products.</p>

        <div class="at-aud" role="group" aria-label="What brings you here?">
          <button type="button" data-aud="hire" aria-pressed="true">Hire me</button>
          <button type="button" data-aud="partner" aria-pressed="false">Partner with me</button>
          <button type="button" data-aud="explore" aria-pressed="false">Explore my work</button>
        </div>

        <div class="at-aud-panel is-on" data-aud-panel="hire">
          <span class="at-aud-tag">For employers &amp; clients</span>
          <p>Looking for multilingual AI evaluation, i18n quality testing, or someone to direct an AI-built product from idea to release?</p>
          <div class="at-actions" style="margin-top:0.9rem">
            <Link href="/atelier/hire/" variant="ink">How can I help you?</Link>
            <Link href={mailto('Discuss a project')} variant="text">Discuss a project</Link>
          </div>
        </div>
        <div class="at-aud-panel" data-aud-panel="partner">
          <span class="at-aud-tag">For partners</span>
          <p>Interested in BackToThePast, historical knowledge data, AI benchmarking or a commercial partnership?</p>
          <div class="at-actions" style="margin-top:0.9rem">
            <Link href="/atelier/backtothepast/#partner" variant="ink">Partner with me</Link>
            <Link href="/atelier/backtothepast/" variant="text">See the game</Link>
          </div>
        </div>
        <div class="at-aud-panel" data-aud-panel="explore">
          <span class="at-aud-tag">For the curious</span>
          <p>See the live game in alpha, the projects in the works and the eight-step method behind them.</p>
          <div class="at-actions" style="margin-top:0.9rem">
            <Link href="#projects" variant="ink">Explore my work</Link>
            <Link href="/atelier/how-i-work/" variant="text">See how I work</Link>
          </div>
        </div>

        <div class="at-hero-meta">
          <span>French-American · Based in Thailand (UTC+7)</span>
          <span>Remote &amp; overnight work welcome</span>
          <span>EN · FR · ES</span>
        </div>
      </div>

      <div data-reveal>
        <BlueprintArt />
      </div>
    </div>
  </section>

  <section class="at-sec" id="proof" data-rail="Proof">
    <div class="at-wrap">
      <ul class="at-proof">
        <li><span class="at-p-k">Track record</span><span class="at-p-v">i18n / l10n QA background at Google (via Accenture) and Apple (via Moravia)</span></li>
        <li><span class="at-p-k">Languages</span><span class="at-p-v">Fluent in English, French and Spanish — native French</span></li>
        <li><span class="at-p-k">Practice</span><span class="at-p-v">Ships with AI daily — a live game in alpha is the proof</span></li>
      </ul>
    </div>
  </section>

  <section class="at-sec at-sec-tint" id="bring" data-rail="What I bring">
    <div class="at-wrap">
      <p class="at-eyebrow">What I bring</p>
      <h2>Business thinking. Product vision. <em class="at-serif">AI execution.</em></h2>
      <div class="at-grid at-g3" style="margin-top:2.4rem">
        <article class="at-card" data-reveal>
          <span class="at-num">i.</span>
          <h3>Business &amp; Strategy</h3>
          <p class="at-grow at-muted">Understanding markets, customers, commercial opportunities, business models and value creation — thirty years of it, internationally.</p>
        </article>
        <article class="at-card" data-reveal>
          <span class="at-num">ii.</span>
          <h3>AI Orchestration</h3>
          <p class="at-grow at-muted">Using AI models and coding agents to explore, structure, challenge and execute complex ideas — as a director, not a typist.</p>
        </article>
        <article class="at-card" data-reveal>
          <span class="at-num">iii.</span>
          <h3>Product Building</h3>
          <p class="at-grow at-muted">Turning concepts into specifications, directing AI-assisted implementation, evaluating outcomes and iterating toward working products.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="at-sec" id="projects" data-rail="Projects">
    <div class="at-wrap">
      <p class="at-eyebrow">Selected projects</p>
      <h2>Things I have directed AI to build.</h2>
      <p class="at-muted">Each project carries its real status. Nothing is shown as launched unless it is.</p>

      <div style="margin-top:2.4rem">
        <article class="at-project">
          <div class="at-project-text">
            <span class="at-chip at-chip-live">Live · Alpha</span>
            <h3>BackToThePast <span class="at-faint">(Guess-History)</span></h3>
            <p>An interactive, multiplayer history and geography guessing game I directed AI coding agents to build — live in alpha, with the ambition to grow into a curated historical knowledge and AI evaluation platform.</p>
            <p class="at-shows">The game · Multiplayer experience · Historical challenge · Data &amp; benchmarking ambition</p>
            <div class="at-actions"><Link href="/atelier/backtothepast/" variant="ink">Explore BackToThePast</Link></div>
          </div>
          <Shot asset="gameScreen1" label="BackToThePast game screenshot" />
        </article>

        <article class="at-project">
          <div class="at-project-text">
            <Ph text="LIKED status — confirm before publishing" />
            <h3>LIKED</h3>
            <p>A digital application designed to organize and manage personal interests, favorites and collections.</p>
            <dl class="at-mini">
              <div><dt>Problem</dt><dd>Personal interests, favorites and collections end up scattered across notes, apps and memory.</dd></div>
              <div><dt>Concept</dt><dd>One application to organize and manage them, built with AI-assisted development.</dd></div>
              <div><dt>Process</dt><dd><Ph text="LIKED: development process detail (specs, AI direction, current state)" /></dd></div>
            </dl>
            <div class="at-actions"><Link value={atelier.likedUrl} label="LIKED project URL" variant="ink">Explore LIKED</Link></div>
          </div>
          <Shot asset="likedScreen" label="LIKED screenshot" />
        </article>

        <article class="at-project">
          <div class="at-project-text">
            <span class="at-chip at-chip-plan">Concept</span>
            <h3>PromptPulse</h3>
            <p>A concept exploring collective intelligence, shared answers and AI evaluation through human-like participation.</p>
            <dl class="at-mini">
              <div><dt>Problem</dt><dd>Evaluating AI output quality at scale needs structured human judgement, not just benchmarks.</dd></div>
              <div><dt>Concept</dt><dd>A mechanics of shared answers and collective intelligence, applied to AI evaluation and data.</dd></div>
              <div><dt>Process</dt><dd><Ph text="PromptPulse: concept detail and potential evaluation/data applications" /></dd></div>
            </dl>
            <div class="at-actions"><Link value={atelier.promptPulseUrl} label="PromptPulse project URL" variant="ink">Explore PromptPulse</Link></div>
          </div>
          <Shot asset="promptPulseScreen" label="PromptPulse concept visual" />
        </article>
      </div>
    </div>
  </section>

  <section class="at-sec at-sec-tint" id="method" data-rail="Method">
    <div class="at-wrap">
      <p class="at-eyebrow">How I work</p>
      <h2>AI is not just a tool I use. <em class="at-serif">It is how I build.</em></h2>
      <p class="at-lead">Eight steps, one loop. I make the decisions; AI agents do the typing.</p>
      <div style="margin-top:2.2rem" data-reveal>
        <Blueprint />
      </div>
      <div class="at-actions"><Link href="/atelier/how-i-work/" variant="line">The full method &amp; case study</Link></div>
    </div>
  </section>

  <section class="at-sec" id="paths" data-rail="Work with me">
    <div class="at-wrap">
      <p class="at-eyebrow">Work with me</p>
      <h2>Two ways to start a conversation.</h2>
      <div class="at-paths" style="margin-top:2.4rem">
        <div class="at-path" data-reveal>
          <span class="at-chip">For employers &amp; clients</span>
          <h3>Hire me</h3>
          <p class="at-muted">For companies, startups and individuals looking for:</p>
          <ul>
            <li>AI solutions and workflow development.</li>
            <li>AI product management.</li>
            <li>AI-assisted application development.</li>
            <li>Business development.</li>
            <li>Product strategy.</li>
            <li>Multilingual digital product QA and evaluation.</li>
          </ul>
          <Link href="/atelier/hire/" variant="ink">Discuss a project</Link>
        </div>
        <div class="at-path at-path-dark" data-reveal>
          <span class="at-chip at-chip-live">For partners</span>
          <h3>Partner with me</h3>
          <p class="at-faint">For people and organizations interested in:</p>
          <ul>
            <li>BackToThePast.</li>
            <li>Historical knowledge databases.</li>
            <li>AI historical benchmarking.</li>
            <li>Content and data partnerships.</li>
            <li>Commercial development.</li>
          </ul>
          <Link href="/atelier/backtothepast/#partner" variant="ink">Explore partnership opportunities</Link>
        </div>
      </div>
    </div>
  </section>

  <section class="at-sec at-sec-tint" id="intro" data-rail="About me">
    <div class="at-wrap">
      <p class="at-eyebrow">A personal note</p>
      <h2>A business person <em class="at-serif">who builds.</em></h2>
      <p>I'm a business and sales professional with an enduring interest in technology and innovation. Over the past 18 months, I've developed practical experience using AI to conceive, direct and build digital products.</p>
      <p>My approach combines commercial reasoning with the ability to work closely with AI systems and coding agents. I enjoy exploring possibilities, challenging assumptions and turning ideas into working solutions.</p>
      <div class="at-actions"><Link href="/atelier/about/" variant="line">Read my story</Link></div>
    </div>
  </section>
</Layout>
