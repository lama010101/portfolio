---
import StudioLayout from '../../layouts/StudioLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ctas } from '../../content/site';
import { workCopy } from '../../content/pages';
import { projects } from '../../content/work';
import { sharedUi, workIndexUi } from '../../content/ui';
---
<StudioLayout title={workCopy.meta.title} description={workCopy.meta.description} path="/work/">
  <PageHero eyebrow={workCopy.hero.eyebrow} titleA={workCopy.hero.titleA} titleB={workCopy.hero.titleB} lede={workCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/services/">{sharedUi.seeServicesLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{workIndexUi.statusGuide.title}</h3>
      <ul class="ds-kicker-list">
        {workIndexUi.statusGuide.items.map((item) => <li><strong>{item.term}</strong> {item.text}</li>)}
      </ul>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="work-index">
    <div class="ds-wrap">
      <SectionHeading eyebrow={workCopy.indexSection.eyebrow} title={workCopy.indexSection.title} lede={workCopy.indexSection.lede} id="work-index" />
      <div class="ds-project-grid">
        {projects.map((project) => <ProjectCard project={project} linkLabel={sharedUi.projectLinkLabel} />)}
      </div>
    </div>
  </section>

  <CtaBand
    title={workIndexUi.cta.title}
    text={workIndexUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.services.label}
    secondaryHref={ctas.services.href}
  />
</StudioLayout>
