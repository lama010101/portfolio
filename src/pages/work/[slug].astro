---
import StudioLayout from '../../layouts/StudioLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ctas } from '../../content/site';
import { projects } from '../../content/work';
import { projectDetailUi, sharedUi } from '../../content/ui';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const description = `${project.name}: ${project.status}. ${project.summary}`;
---
<StudioLayout title={project.name} description={description} path={`/work/${project.slug}/`}>
  <PageHero eyebrow={project.kind} titleA={project.name} titleB={project.status} lede={project.summary}>
    <div slot="actions" class="ds-actions ds-reveal">
      {project.links.map((link) => (
        <a class="ds-btn ds-btn-primary" href={link.href} rel="noopener">{link.label}<span aria-hidden="true"> ↗</span></a>
      ))}
      <a class="ds-btn ds-btn-ghost" href="/work/">{sharedUi.backToWorkIndexLabel}</a>
    </div>
    <div>
      <ProjectVisual type={project.visual} title={project.name} />
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="project-status">
    <div class="ds-wrap ds-grid-2">
      <div class="ds-panel">
        <p class="ds-eyebrow">{projectDetailUi.status.eyebrow}</p>
        <h2 class="ds-h2" id="project-status">{projectDetailUi.status.title}</h2>
        <span class="ds-status-note">{project.status}</span>
        <ul class="ds-kicker-list" style="margin-top:1rem">
          {project.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        {project.caveat && <p class="ds-caveat">{project.caveat}</p>}
      </div>
      <div class="ds-panel">
        <p class="ds-eyebrow">{projectDetailUi.capabilities.eyebrow}</p>
        <h2 class="ds-h2">{projectDetailUi.capabilities.title}</h2>
        <ul class="ds-pill-list">
          {project.capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
        <p class="ds-section-lede" style="margin-top:1.25rem">{projectDetailUi.capabilities.note}</p>
      </div>
    </div>
  </section>

  <CtaBand
    title={projectDetailUi.cta.title}
    text={projectDetailUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
