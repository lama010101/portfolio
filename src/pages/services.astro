---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OfferCard from '../components/OfferCard.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE_NAME, SITE_URL } from '../config';
import { ctas, engagementSteps, studioFacts } from '../content/site';
import { servicesCopy } from '../content/pages';
import { servicesUi, sharedUi } from '../content/ui';
import { buildCapabilities, serviceOffers } from '../content/services';
import { packageFootnotes, packageOffers } from '../content/packages';

const serviceSchemas = serviceOffers.map((offer) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: offer.title,
  serviceType: offer.title,
  description: offer.summary,
  provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  url: new URL(offer.href, SITE_URL).href,
}));
---
<StudioLayout title={servicesCopy.meta.title} description={servicesCopy.meta.description} path="/services/" jsonld={serviceSchemas}>
  <PageHero eyebrow={servicesCopy.hero.eyebrow} titleA={servicesCopy.hero.titleA} titleB={servicesCopy.hero.titleB} lede={servicesCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="#packages">{sharedUi.comparePackagesLabel}</a>
    </div>
    <dl class="ds-facts">
      {studioFacts.map((fact) => (
        <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
      ))}
    </dl>
  </PageHero>

  <section class="ds-section" aria-labelledby="service-offers">
    <div class="ds-wrap">
      <SectionHeading eyebrow={servicesCopy.offersSection.eyebrow} title={servicesCopy.offersSection.title} lede={servicesCopy.offersSection.lede} id="service-offers" />
      <div class="ds-grid-2">
        {serviceOffers.map((offer) => <OfferCard offer={offer} detailed />)}
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-alt" id="packages" aria-labelledby="packages-title">
    <div class="ds-wrap">
      <SectionHeading eyebrow={servicesCopy.packagesSection.eyebrow} title={servicesCopy.packagesSection.title} lede={servicesCopy.packagesSection.lede} id="packages-title" />
      <div class="ds-package-grid">
        {packageOffers.map((pkg) => <PackageCard pkg={pkg} deliveryLabel={servicesCopy.packagesSection.deliveryLabel} />)}
      </div>
      <ul class="ds-footnotes" aria-label={sharedUi.packageNotesLabel}>
        {packageFootnotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="build-capabilities">
    <div class="ds-wrap">
      <SectionHeading eyebrow={servicesCopy.buildSection.eyebrow} title={servicesCopy.buildSection.title} lede={servicesCopy.buildSection.lede} id="build-capabilities" />
      <ul class="ds-pill-list">
        {buildCapabilities.map((capability) => <li>{capability}</li>)}
      </ul>
      <div class="ds-actions">
        <a class="ds-btn ds-btn-ghost" href="/how-we-build/">{sharedUi.readBuildMethodLabel}<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-dark" aria-labelledby="service-process">
    <div class="ds-wrap">
      <SectionHeading eyebrow={servicesCopy.processSection.eyebrow} title={servicesCopy.processSection.title} lede={servicesCopy.processSection.lede} id="service-process" />
      <ol class="ds-method-grid">
        {engagementSteps.map((step) => (
          <li class="ds-method-card ds-reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title={servicesUi.cta.title}
    text={servicesUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
