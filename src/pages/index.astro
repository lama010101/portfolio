---
import StudioLayout from '../layouts/StudioLayout.astro';
import ScoreCanvas from '../components/ScoreCanvas.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OfferCard from '../components/OfferCard.astro';
import PackageCard from '../components/PackageCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ctas, engagementSteps } from '../content/site';
import { homeCopy } from '../content/pages';
import { homeUi, sharedUi } from '../content/ui';
import { serviceOffers, verificationPrinciples } from '../content/services';
import { packageOffers } from '../content/packages';
import { projects } from '../content/work';

const featuredPackages = packageOffers.filter((pkg) => ['starter-audit', 'launch-audit', 'ai-evaluation-pilot'].includes(pkg.id));
---
<StudioLayout title={homeCopy.meta.title} description={homeCopy.meta.description} path="/">
  <section class="ds-hero" aria-labelledby="home-title">
    <div class="ds-wrap ds-hero-grid">
      <div class="ds-hero-copy">
        <p class="ds-eyebrow ds-reveal">{homeCopy.hero.eyebrow}</p>
        <h1 class="ds-h1 ds-reveal" id="home-title">
          {homeCopy.hero.titleA}
          <span class="ds-title-rest"><em>{homeCopy.hero.titleB}</em></span>
        </h1>
        <p class="ds-lede ds-reveal">{homeCopy.hero.lede}</p>
        <div class="ds-actions ds-reveal">
          <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
          <a class="ds-btn ds-btn-ghost" href={ctas.services.href}>{ctas.services.label}</a>
        </div>
        <ul class="ds-hero-proof ds-reveal" aria-label={sharedUi.homeOffersLabel}>
          {homeUi.offerLabels.map((label) => <li>{label}</li>)}
        </ul>
        <p class="ds-hero-support ds-reveal">{homeCopy.hero.support}</p>
      </div>
      <ScoreCanvas label={homeCopy.hero.scoreLabel} text={homeCopy.hero.scoreText} />
    </div>
  </section>

  <section class="ds-section" aria-labelledby="home-offers">
    <div class="ds-wrap">
      <SectionHeading eyebrow={homeCopy.offers.eyebrow} title={homeCopy.offers.title} accent={homeCopy.offers.accent} lede={homeCopy.offers.lede} id="home-offers" />
      <div class="ds-offer-grid">
        {serviceOffers.map((offer) => <OfferCard offer={offer} />)}
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="home-packages">
    <div class="ds-wrap">
      <SectionHeading eyebrow={homeCopy.packages.eyebrow} title={homeCopy.packages.title} lede={homeCopy.packages.lede} id="home-packages" />
      <div class="ds-package-grid">
        {featuredPackages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
      <div class="ds-actions">
        <a class="ds-btn ds-btn-ghost" href="/services/#packages">{homeCopy.packages.linkLabel}<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-dark" aria-labelledby="home-verify">
    <div class="ds-wrap">
      <SectionHeading eyebrow={homeCopy.verification.eyebrow} title={homeCopy.verification.title} lede={homeCopy.verification.lede} id="home-verify" />
      <div class="ds-method-grid">
        {verificationPrinciples.slice(1, 5).map((principle) => (
          <article class="ds-method-card ds-reveal">
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </article>
        ))}
      </div>
      <div class="ds-actions">
        <a class="ds-btn ds-btn-light" href={ctas.verify.href}>{homeCopy.verification.linkLabel}<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <section class="ds-section" aria-labelledby="home-work">
    <div class="ds-wrap">
      <SectionHeading eyebrow={homeCopy.work.eyebrow} title={homeCopy.work.title} lede={homeCopy.work.lede} id="home-work" />
      <div class="ds-project-grid">
        {projects.map((project) => <ProjectCard project={project} linkLabel={sharedUi.projectLinkLabel} />)}
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="home-process">
    <div class="ds-wrap">
      <SectionHeading eyebrow={homeCopy.process.eyebrow} title={homeCopy.process.title} lede={homeCopy.process.lede} id="home-process" />
      <ol class="ds-method-grid">
        {engagementSteps.map((step) => (
          <li class="ds-method-card ds-reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title={homeCopy.final.title}
    text={homeCopy.final.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.services.label}
    secondaryHref={ctas.services.href}
  />
</StudioLayout>
