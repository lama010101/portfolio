---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { ctas } from '../content/site';
import { howBuildCopy } from '../content/pages';
import { buildCapabilities } from '../content/services';
import { howBuildUi, sharedUi } from '../content/ui';
---
<StudioLayout title={howBuildCopy.meta.title} description={howBuildCopy.meta.description} path="/how-we-build/">
  <PageHero eyebrow={howBuildCopy.hero.eyebrow} titleA={howBuildCopy.hero.titleA} titleB={howBuildCopy.hero.titleB} lede={howBuildCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.build.href}>{ctas.build.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/work/">{sharedUi.seeWhatExistsLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{howBuildUi.aside.title}</h3>
      <p class="ds-section-lede">{howBuildUi.aside.text}</p>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="build-capabilities">
    <div class="ds-wrap">
      <SectionHeading eyebrow={howBuildCopy.capabilities.eyebrow} title={howBuildCopy.capabilities.title} lede={howBuildCopy.capabilities.lede} id="build-capabilities" />
      <ul class="ds-pill-list">
        {buildCapabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="build-method">
    <div class="ds-wrap">
      <SectionHeading eyebrow={howBuildCopy.method.eyebrow} title={howBuildCopy.method.title} id="build-method" />
      <ol class="ds-method-grid">
        {howBuildCopy.method.steps.map((step) => (
          <li class="ds-method-card ds-reveal">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title={howBuildUi.cta.title}
    text={howBuildUi.cta.text}
    primaryLabel={ctas.build.label}
    primaryHref={ctas.build.href}
    secondaryLabel={ctas.spotCheck.label}
    secondaryHref={ctas.spotCheck.href}
  />
</StudioLayout>
