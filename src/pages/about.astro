---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { ctas, studioFacts } from '../content/site';
import { aboutCopy } from '../content/pages';
import { aboutUi, sharedUi } from '../content/ui';
---
<StudioLayout title={aboutCopy.meta.title} description={aboutCopy.meta.description} path="/about/">
  <PageHero eyebrow={aboutCopy.hero.eyebrow} titleA={aboutCopy.hero.titleA} titleB={aboutCopy.hero.titleB} lede={aboutCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/work/">{sharedUi.inspectWorkLabel}</a>
    </div>
    <dl class="ds-facts">
      {studioFacts.map((fact) => (
        <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>
      ))}
    </dl>
  </PageHero>

  <section class="ds-section" aria-labelledby="about-model">
    <div class="ds-wrap">
      <SectionHeading eyebrow={aboutCopy.model.eyebrow} title={aboutCopy.model.title} lede={aboutCopy.model.lede} id="about-model" />
      <div class="ds-grid-2">
        {aboutCopy.model.cards.map((card) => (
          <article class="ds-method-card ds-reveal">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-dark" aria-labelledby="about-language">
    <div class="ds-wrap">
      <p class="ds-eyebrow ds-eyebrow-invert">{aboutCopy.language.eyebrow}</p>
      <h2 class="ds-h2" id="about-language">{aboutCopy.language.title}</h2>
      <p class="ds-section-lede">{aboutCopy.language.text}</p>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="about-principles">
    <div class="ds-wrap">
      <SectionHeading eyebrow={aboutCopy.principles.eyebrow} title={aboutCopy.principles.title} id="about-principles" />
      <ol class="ds-kicker-list">
        {aboutCopy.principles.items.map((item, index) => (
          <li class="ds-reveal"><strong>{String(index + 1).padStart(2, '0')}</strong>{item}</li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title={aboutUi.cta.title}
    text={aboutUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.contact.label}
    secondaryHref={ctas.contact.href}
  />
</StudioLayout>
