---
import StudioLayout from '../layouts/StudioLayout.astro';
import { mailto } from '../config';
import { languageBadge, methodSteps, offers } from '../data/studio';

const offer = offers[1];
const description = 'Human evaluation of AI model outputs in French, English and Spanish: rubrics, annotation guidelines, calibration sets and failure-mode reports.';
---
<StudioLayout title="Multilingual AI evaluation" description={description} path="/ai-evaluation/">
  <section class="ll-page-hero">
    <div class="ll-wrap">
      <p class="ll-crumbs"><a href="/">Home</a> / Offers / AI Evaluation</p>
      <p class="ll-eyebrow">Offer 02</p>
      <h1 class="ll-h1">Multilingual AI evaluation</h1>
      <p class="ll-sub" style="margin-top:1rem">{offer.tagline} {offer.summary}</p>
      <div class="ll-actions">
        <a class="ll-btn ll-btn-solid" href={mailto('Quote request — Multilingual AI evaluation')}>Request a quote <span aria-hidden="true">&rarr;</span></a>
        <a class="ll-btn ll-btn-ghost" href="/capability-statement.pdf">Vendor one-pager (PDF)</a>
      </div>
    </div>
  </section>

  <section class="ll-sec" aria-labelledby="e-scope">
    <div class="ll-wrap">
      <p class="ll-eyebrow">What gets evaluated</p>
      <h2 id="e-scope" class="ll-h2">Human judgement, <em>in three languages.</em></h2>
      <div class="ll-grid-2" style="margin-top:2rem">
        <div class="ll-card">
          <h3 style="font-family:var(--serif);font-size:1.3rem;margin-bottom:0.75rem">Model output review</h3>
          <ul class="ll-proof-body" style="padding:0">
            <li>Accuracy, fluency and instruction following per language</li>
            <li>Cultural fit: idioms, register, local conventions</li>
            <li>Consistency across FR, EN and ES outputs</li>
            <li>Edge cases your eval set already surfaces — or misses</li>
          </ul>
        </div>
        <div class="ll-card">
          <h3 style="font-family:var(--serif);font-size:1.3rem;margin-bottom:0.75rem">Eval infrastructure</h3>
          <ul class="ll-proof-body" style="padding:0">
            <li>Rubric and annotation-guideline writing for your use case</li>
            <li>Calibration sets so reviewers score the same way</li>
            <li>Failure-mode taxonomy: what breaks, where, how often</li>
            <li>Second-language checks EN&harr;ES against French-primary reference</li>
          </ul>
        </div>
      </div>
      <p class="ll-note">{languageBadge}. Evaluation is done by a human reviewer; automated tools assist triage only where the client allows it.</p>
    </div>
  </section>

  <section class="ll-sec ll-sec-alt" aria-labelledby="e-deliver">
    <div class="ll-wrap">
      <p class="ll-eyebrow">Deliverables</p>
      <h2 id="e-deliver" class="ll-h2">What lands in your inbox.</h2>
      <div class="ll-table-wrap" style="margin-top:2rem">
        <table class="ll-table">
          <tbody>
            <tr><th scope="row">Evaluation report</th><td>Scores per language and per dimension, with cited examples — no invented aggregates.</td></tr>
            <tr><th scope="row">Rubric &amp; guidelines</th><td>Annotation guidelines and scoring rubrics written for your product and reusable by your team.</td></tr>
            <tr><th scope="row">Calibration set</th><td>A small annotated set for aligning your own reviewers or vendors.</td></tr>
            <tr><th scope="row">Failure-mode report</th><td>Taxonomy of recurring failures by language, severity and category.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="ll-actions">
        <a class="ll-btn ll-btn-solid" href={mailto('Quote request — Multilingual AI evaluation')}>Request a quote</a>
      </div>
    </div>
  </section>

  <section class="ll-sec" aria-labelledby="e-method">
    <div class="ll-wrap">
      <p class="ll-eyebrow">How it runs</p>
      <h2 id="e-method" class="ll-h2">The same five steps, every engagement.</h2>
      <ol class="ll-steps" style="grid-template-columns:repeat(auto-fit,minmax(12rem,1fr))">
        {methodSteps.map((s) => (
          <li class="ll-step"><b>{s.n}</b><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="ll-actions">
        <a class="ll-btn ll-btn-ghost" href="/quality/">Also need app QA? See localization &amp; i18n QA</a>
        <a class="ll-btn ll-btn-ghost" href="/proof/">See proof &amp; scoring methodology</a>
      </div>
    </div>
  </section>
</StudioLayout>
