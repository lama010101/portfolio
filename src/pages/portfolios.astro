---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE_NAME } from '../config';
import { portfolioHubCopy } from '../content/pages';
---
<StudioLayout title={portfolioHubCopy.meta.title} description={portfolioHubCopy.meta.description} path="/portfolios/">
  <PageHero eyebrow={portfolioHubCopy.hero.eyebrow} titleA={portfolioHubCopy.hero.titleA} titleB={portfolioHubCopy.hero.titleB} lede={portfolioHubCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      {portfolioHubCopy.current.links.slice(0, 2).map((link, index) => (
        <a class:list={['ds-btn', index === 0 ? 'ds-btn-primary' : 'ds-btn-ghost']} href={link.href}>{link.label}<span aria-hidden="true"> →</span></a>
      ))}
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="hub-current">
    <div class="ds-wrap">
      <SectionHeading eyebrow={portfolioHubCopy.current.eyebrow} title={portfolioHubCopy.current.title} lede={portfolioHubCopy.current.lede} id="hub-current" />
      <article class="ds-panel ds-hub-current ds-reveal" data-spot>
        <div class="ds-project-meta">
          <span>{portfolioHubCopy.current.kind}</span>
          <strong>{portfolioHubCopy.current.status}</strong>
        </div>
        <h3>{SITE_NAME}</h3>
        <p>{portfolioHubCopy.current.summary}</p>
        <ul class="ds-hub-links">
          {portfolioHubCopy.current.links.map((link) => (
            <li><a class="ds-textlink" href={link.href}>{link.label}<span aria-hidden="true"> →</span></a></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="hub-retired">
    <div class="ds-wrap">
      <SectionHeading eyebrow={portfolioHubCopy.retired.eyebrow} title={portfolioHubCopy.retired.title} lede={portfolioHubCopy.retired.lede} id="hub-retired" />
      <ul class="ds-retired-list">
        {portfolioHubCopy.retired.items.map((item) => (
          <li class="ds-reveal"><span>{item}</span><small>{portfolioHubCopy.retired.statusLabel}</small></li>
        ))}
      </ul>
    </div>
  </section>
</StudioLayout>
