---
import StudioLayout from '../layouts/StudioLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PackageCard from '../components/PackageCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ctas } from '../content/site';
import { qualityCopy } from '../content/quality';
import { packageOffers } from '../content/packages';
import { qualityIndexUi, sharedUi } from '../content/ui';

const qaPackages = packageOffers.filter((pkg) => ['starter-audit', 'launch-audit', 'release-watch', 'lqa-day'].includes(pkg.id));
---
<StudioLayout title={qualityCopy.meta.title} description={qualityCopy.meta.description} path="/quality/">
  <PageHero eyebrow={qualityCopy.hero.eyebrow} titleA={qualityCopy.hero.titleA} titleB={qualityCopy.hero.titleB} lede={qualityCopy.hero.lede}>
    <div slot="actions" class="ds-actions ds-reveal">
      <a class="ds-btn ds-btn-primary" href={ctas.spotCheck.href}>{ctas.spotCheck.label}<span aria-hidden="true"> →</span></a>
      <a class="ds-btn ds-btn-ghost" href="/quality/french-lqa-testing/">{sharedUi.frenchLqaTestingLabel}</a>
    </div>
    <div class="ds-panel">
      <h3>{qualityCopy.languages.title}</h3>
      <p class="ds-section-lede">{qualityCopy.languages.text}</p>
    </div>
  </PageHero>

  <section class="ds-section" aria-labelledby="qa-scope">
    <div class="ds-wrap">
      <SectionHeading eyebrow={qualityCopy.scope.eyebrow} title={qualityCopy.scope.title} id="qa-scope" />
      <div class="ds-grid-2">
        {qualityCopy.scope.cards.map((card) => (
          <article class="ds-method-card ds-reveal">
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ds-section ds-section-alt" aria-labelledby="qa-packages">
    <div class="ds-wrap">
      <SectionHeading eyebrow={qualityIndexUi.packagesSection.eyebrow} title={qualityIndexUi.packagesSection.title} lede={qualityIndexUi.packagesSection.lede} id="qa-packages" />
      <div class="ds-package-grid">
        {qaPackages.map((pkg) => <PackageCard pkg={pkg} />)}
      </div>
    </div>
  </section>

  <CtaBand
    title={qualityIndexUi.cta.title}
    text={qualityIndexUi.cta.text}
    primaryLabel={ctas.spotCheck.label}
    primaryHref={ctas.spotCheck.href}
    secondaryLabel={ctas.quote.label}
    secondaryHref={ctas.quote.href}
  />
</StudioLayout>
