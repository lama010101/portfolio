---
import '../styles/site.css';
import { CONTACT_EMAIL, SITE_NAME, SITE_TAGLINE, SITE_URL, ogImage, pageUrl } from '../config';
import { brand, ctas, footerCopy, navigation } from '../content/site';
import { sharedUi } from '../content/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonld?: object[];
}
const { title, description, path, jsonld = [] } = Astro.props;
const isHome = path === '/';
const fullTitle = isHome ? `${SITE_NAME} — ${title}` : `${title} | ${SITE_NAME}`;
const canonical = pageUrl(path);
const og = new URL(ogImage, SITE_URL).href;

const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  description: `${SITE_TAGLINE} ${brand.shortPitch}`,
  url: SITE_URL,
  email: CONTACT_EMAIL,
  knowsLanguage: ['French', 'English', 'Spanish'],
};
const schemas = [organization, ...jsonld];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2EDE2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="ds">
    <a class="ds-skip" href="#main">{sharedUi.skipToContent}</a>
    <header class="ds-header">
      <div class="ds-wrap ds-header-inner">
        <a class="ds-brand" href="/" aria-label={sharedUi.brandHomeLabel(SITE_NAME)}>
          <svg class="ds-brandmark" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
            <rect width="44" height="44" rx="12"></rect>
            <path d="M10 27c7-11 13-11 20 0" />
            <path d="M14 17c5 8 11 8 16 0" />
            <circle cx="31" cy="27" r="2.5" />
          </svg>
          <span>{SITE_NAME}</span>
        </a>
        <nav class="ds-nav" aria-label={sharedUi.mainNavigationLabel}>
          {navigation.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <a class="ds-header-cta" href="/spot-check/">{sharedUi.headerCtaLabel}</a>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="ds-footer">
      <div class="ds-wrap ds-footer-grid">
        <div class="ds-footer-brand">
          <a class="ds-brand" href="/" aria-label={sharedUi.brandHomeLabel(SITE_NAME)}>
            <svg class="ds-brandmark" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
              <rect width="44" height="44" rx="12"></rect>
              <path d="M10 27c7-11 13-11 20 0" />
              <path d="M14 17c5 8 11 8 16 0" />
              <circle cx="31" cy="27" r="2.5" />
            </svg>
            <span>{SITE_NAME}</span>
          </a>
          <p>{footerCopy.line}</p>
          <p class="ds-footer-note">{footerCopy.note}</p>
        </div>
        <nav class="ds-footer-nav" aria-label={sharedUi.footerNavigationLabel}>
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/terms-of-work/">{sharedUi.termsLabel}</a>
        </nav>
        <div class="ds-footer-contact">
          <span>{CONTACT_EMAIL}</span>
          <a class="ds-btn ds-btn-outline-light" href={ctas.spotCheck.href}>{ctas.spotCheck.label}</a>
          <a class="ds-textlink ds-textlink-light" href={ctas.contact.href}>{sharedUi.generalEmailLabel}<span aria-hidden="true"> →</span></a>
        </div>
      </div>
    </footer>
    <script src="/site.js" defer></script>
  </body>
</html>
