---
interface Props { label?: string }
const { label = 'Method illustration — the Idea to Product loop in eight steps' } = Astro.props;
---
<figure class="at-figure">
  <svg class="at-blueprint-art" viewBox="0 0 560 560" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="at-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L8 4 L0 8" fill="none" stroke="#D2462A" stroke-width="1.4" />
      </marker>
    </defs>

    <!-- registration grid -->
    <g stroke="#E4DDD0" stroke-width="1">
      <line x1="80" y1="280" x2="480" y2="280" />
      <line x1="280" y1="80" x2="280" y2="480" />
      <line x1="139" y1="139" x2="421" y2="421" />
      <line x1="421" y1="139" x2="139" y2="421" />
    </g>

    <!-- radial spokes -->
    <g stroke="#E4DDD0" stroke-width="1">
      <line x1="280" y1="150" x2="280" y2="225" />
      <line x1="371.9" y1="188.1" x2="439.1" y2="120.9" />
      <line x1="410" y1="280" x2="505" y2="280" />
      <line x1="371.9" y1="371.9" x2="439.1" y2="439.1" />
      <line x1="280" y1="410" x2="280" y2="505" />
      <line x1="188.1" y1="371.9" x2="120.9" y2="439.1" />
      <line x1="150" y1="280" x2="55" y2="280" />
      <line x1="188.1" y1="188.1" x2="120.9" y2="120.9" />
    </g>

    <!-- rings -->
    <circle cx="280" cy="280" r="230" fill="none" stroke="#14161B" stroke-width="1.3" />
    <circle cx="280" cy="280" r="185" fill="none" stroke="#1F3D5A" stroke-width="1" stroke-dasharray="3 6" />
    <circle cx="280" cy="280" r="120" fill="none" stroke="#D9D1BF" stroke-width="1" />
    <circle cx="280" cy="280" r="86" fill="none" stroke="#1F3D5A" stroke-width="0.8" stroke-dasharray="2 5" opacity="0.75" />

    <!-- vermilion progress arc -->
    <path d="M 280 50 A 230 230 0 0 1 442.6 117.4" fill="none" stroke="#D2462A" stroke-width="4" />
    <path d="M 103.2 456.8 A 230 230 0 0 1 50 280" fill="none" stroke="#D2462A" stroke-width="4" opacity="0.45" />

    <!-- dimension ticks -->
    <g stroke="#14161B" stroke-width="1" opacity="0.55">
      <line x1="368.1" y1="67.5" x2="371.9" y2="58.2" />
      <line x1="492.5" y1="192" x2="501.8" y2="188.1" />
      <line x1="492.5" y1="368.1" x2="501.8" y2="371.9" />
      <line x1="368.1" y1="492.5" x2="371.9" y2="501.8" />
      <line x1="191.9" y1="492.5" x2="188.1" y2="501.8" />
      <line x1="67.5" y1="368.1" x2="58.2" y2="371.9" />
      <line x1="67.5" y1="191.9" x2="58.2" y2="188.1" />
      <line x1="191.9" y1="67.5" x2="188.1" y2="58.2" />
    </g>

    <!-- nodes -->
    <g fill="#D2462A">
      <circle cx="280" cy="50" r="5.5" />
      <circle cx="442.6" cy="117.4" r="5.5" />
      <circle cx="510" cy="280" r="5.5" />
      <circle cx="442.6" cy="442.6" r="5.5" />
      <circle cx="280" cy="510" r="5.5" />
      <circle cx="117.4" cy="442.6" r="5.5" />
      <circle cx="50" cy="280" r="5.5" />
      <circle cx="117.4" cy="117.4" r="5.5" />
    </g>
    <g fill="#F6F2EA">
      <circle cx="280" cy="50" r="2" />
      <circle cx="442.6" cy="117.4" r="2" />
      <circle cx="510" cy="280" r="2" />
      <circle cx="442.6" cy="442.6" r="2" />
      <circle cx="280" cy="510" r="2" />
      <circle cx="117.4" cy="442.6" r="2" />
      <circle cx="50" cy="280" r="2" />
      <circle cx="117.4" cy="117.4" r="2" />
    </g>

    <!-- step labels -->
    <g font-family="ui-monospace, 'Cascadia Mono', Consolas, monospace" font-size="11" letter-spacing="1.5" fill="#6D7078">
      <text x="280" y="78" text-anchor="middle">01 · IDENTIFY</text>
      <text x="421" y="141" text-anchor="end">02 · OBJECTIVE</text>
      <text x="480" y="284" text-anchor="end">03 · EXPLORE</text>
      <text x="421" y="428" text-anchor="end">04 · REQUIRE</text>
      <text x="280" y="488" text-anchor="middle">05 · DIRECT</text>
      <text x="139" y="428" text-anchor="start">06 · EVALUATE</text>
      <text x="80" y="284" text-anchor="start">07 · CHALLENGE</text>
      <text x="139" y="141" text-anchor="start">08 · ITERATE</text>
    </g>

    <!-- center mark -->
    <g>
      <circle cx="280" cy="280" r="4.5" fill="#D2462A" />
      <line x1="255" y1="280" x2="240" y2="280" stroke="#D2462A" stroke-width="1.2" marker-end="url(#at-arr)" />
      <line x1="305" y1="280" x2="320" y2="280" stroke="#D2462A" stroke-width="1.2" marker-end="url(#at-arr)" />
      <text x="280" y="240" text-anchor="middle" font-family="'Fraunces Variable', Georgia, serif" font-style="italic" font-size="30" fill="#14161B">idea</text>
      <text x="280" y="335" text-anchor="middle" font-family="'Fraunces Variable', Georgia, serif" font-style="italic" font-size="30" fill="#14161B">product</text>
      <text x="280" y="368" text-anchor="middle" font-family="ui-monospace, 'Cascadia Mono', Consolas, monospace" font-size="9.5" letter-spacing="3" fill="#6D7078">METHOD · LOOP</text>
    </g>

    <!-- corner marks -->
    <g stroke="#14161B" stroke-width="1" opacity="0.6">
      <path d="M 14 30 V 14 H 30" fill="none" />
      <path d="M 546 30 V 14 H 530" fill="none" />
      <path d="M 14 530 V 546 H 30" fill="none" />
      <path d="M 546 530 V 546 H 530" fill="none" />
    </g>
    <text x="546" y="556" text-anchor="end" font-family="ui-monospace, 'Cascadia Mono', Consolas, monospace" font-size="8.5" letter-spacing="2" fill="#6D7078">L/ATELIER — SHEET 01</text>
  </svg>
  <figcaption>{label}</figcaption>
</figure>
