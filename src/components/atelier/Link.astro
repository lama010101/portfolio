---
import { isPh } from '../../data/atelier';
interface Props {
  href?: string;
  value?: string;
  label?: string;
  variant?: 'ink' | 'verm' | 'line' | 'text';
  small?: boolean;
  class?: string;
}
const { href, value, label = 'link', variant = 'text', small = false, class: cls } = Astro.props;
const target = href ?? value;
const missing = !target || isPh(target);
const external = !!target && /^https?:/.test(target);
const clsFor = variant === 'text' ? 'at-tlink' : `at-btn at-btn-${variant}${small ? ' at-btn-sm' : ''}`;
---
{missing ? (
  <span class:list={['at-link-missing', cls]}>
    <a class={clsFor} href="#" aria-disabled="true" tabindex="-1"><slot /></a>
    <span class="at-ph" data-placeholder>[[PLACEHOLDER: {label}]]</span>
  </span>
) : (
  <a class:list={[clsFor, cls]} href={target}
     {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><slot /></a>
)}
