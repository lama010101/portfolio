---
import { isPlaceholder } from '../config';
interface Props {
  href?: string;
  value?: string;
  label?: string;
  variant?: 'solid' | 'ghost' | 'signal' | 'text';
  class?: string;
}
const { href, value, label = 'link', variant = 'ghost', class: cls } = Astro.props;
const target = href ?? value;
const missing = !target || isPlaceholder(target);
const external = !!target && /^https?:/.test(target);
const btn = variant === 'text' ? 'ln-tlink' : `ln-btn ln-btn-${variant}`;
---
{missing ? (
  <span class:list={['ln-missing', cls]}>
    <a class={btn} href="#" aria-disabled="true" tabindex="-1"><slot /></a>
    <span class="ph" data-placeholder>[[PLACEHOLDER: {label}]]</span>
  </span>
) : (
  <a class:list={[btn, cls]} href={target} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><slot /></a>
)}
